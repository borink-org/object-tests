{
  "version": 1,
  "profiles": {
    "azure": {
      "provider": "azure",
      "endpoint": {
        "bucket": "fixture",
        "account": "fixture",
        "region": "us-east-1"
      },
      "checks": [
        {
          "at": "/headers/x-ms-date",
          "rule": {
            "is": "fresh",
            "format": "http",
            "max_past_seconds": 900,
            "max_future_seconds": 60
          },
          "optional": true
        },
        {
          "at": "/headers/date",
          "rule": {
            "is": "fresh",
            "format": "http",
            "max_past_seconds": 900,
            "max_future_seconds": 60
          },
          "optional": true
        },
        {
          "at": "/headers/x-ms-client-request-id",
          "rule": {
            "is": "matches",
            "pattern": ".{0,1024}"
          },
          "optional": true
        },
        {
          "at": "/headers/x-ms-version",
          "rule": {
            "is": "one_of",
            "values": [
              "2018-11-09",
              "2019-12-12",
              "2020-10-02",
              "2021-12-02",
              "2023-11-03",
              "2024-11-04",
              "2025-01-05",
              "2025-11-05",
              "2026-02-06",
              "2026-04-06"
            ]
          }
        }
      ],
      "allow_headers": [
        "host",
        "content-length",
        "transfer-encoding",
        "connection",
        "expect",
        "user-agent",
        "accept",
        "accept-encoding",
        "authorization"
      ],
      "allow_query": []
    },
    "s3": {
      "provider": "s3",
      "endpoint": {
        "bucket": "fixture",
        "account": "fixture",
        "region": "us-east-1"
      },
      "checks": [
        {
          "at": "/headers/x-amz-date",
          "rule": {
            "is": "fresh",
            "format": "amz",
            "max_past_seconds": 900,
            "max_future_seconds": 60
          },
          "optional": true
        },
        {
          "at": "/headers/x-amz-content-sha256",
          "rule": {
            "is": "matches",
            "pattern": "[0-9a-f]{64}|UNSIGNED-PAYLOAD"
          },
          "optional": true
        },
        {
          "at": "/headers/x-amz-api-version",
          "optional": true,
          "rule": {
            "is": "equal",
            "value": "2006-03-01"
          }
        },
        {
          "at": "/raw_query",
          "rule": {
            "is": "matches",
            "pattern": "[^+]*"
          },
          "because": "S3 reads a + in a query as a space, so a plus in a prefix, token or upload ID must go as %2B and a space as %20"
        }
      ],
      "allow_headers": [
        "host",
        "content-length",
        "transfer-encoding",
        "connection",
        "expect",
        "user-agent",
        "accept",
        "accept-encoding",
        "authorization",
        "amz-sdk-invocation-id",
        "amz-sdk-request",
        "x-amz-user-agent"
      ],
      "allow_query": []
    }
  },
  "cases": [
    {
      "id": "azure/get-key-plain",
      "profile": "azure",
      "lane": "core",
      "purpose": "get key plain",
      "sources": [
        "https://learn.microsoft.com/en-us/rest/api/storageservices/get-blob"
      ],
      "call": {
        "op": "get",
        "key": "object"
      },
      "exchanges": [
        {
          "alternatives": [
            {
              "request": [
                {
                  "at": "/method",
                  "rule": {
                    "is": "equal",
                    "value": "GET"
                  }
                },
                {
                  "at": "/path",
                  "rule": {
                    "is": "equal",
                    "value": "/fixture/object"
                  }
                },
                {
                  "at": "/body_base64",
                  "rule": {
                    "is": "equal",
                    "value": ""
                  }
                }
              ],
              "response": {
                "status": 200,
                "headers": {
                  "date": {
                    "from": "now"
                  },
                  "etag": "\"fixture-etag\"",
                  "last-modified": "Mon, 01 Jan 2024 00:00:00 GMT",
                  "content-type": "application/octet-stream",
                  "x-ms-request-id": "fixture-request-id",
                  "x-ms-version": "2023-11-03",
                  "x-ms-blob-type": "BlockBlob",
                  "x-ms-creation-time": "Mon, 01 Jan 2024 00:00:00 GMT",
                  "x-ms-server-encrypted": "true",
                  "x-ms-request-server-encrypted": "true",
                  "x-ms-lease-status": "unlocked",
                  "x-ms-lease-state": "available"
                },
                "body": {
                  "encoding": "base64",
                  "data": "aGVsbG8="
                }
              },
              "allow_headers": [],
              "allow_query": []
            }
          ]
        }
      ],
      "expect": [
        {
          "at": "/outcome",
          "rule": {
            "is": "equal",
            "value": "ok"
          }
        },
        {
          "at": "/value/body_base64",
          "rule": {
            "is": "equal",
            "value": "aGVsbG8="
          }
        }
      ]
    },
