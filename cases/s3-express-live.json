{
  "version": 1,
  "profiles": {
    "s3-express": {
      "provider": "s3",
      "endpoint": {}
    }
  },
  "cases": [
    {
      "id": "s3-express/live-authenticated-read",
      "profile": "s3-express",
      "lane": "live",
      "purpose": "Service acceptance of a fresh signed request using credentials supplied by the caller.",
      "sources": [
        "aws-sdk-cpp/generated/src/aws-cpp-sdk-s3-crt/source/S3ExpressIdentityProvider.cpp"
      ],
      "call": {
        "op": "get",
        "key": "object-tests-auth-probe",
        "credential_mode": "environment"
      },
      "expect": [
        {
          "at": "/outcome",
          "rule": {
            "is": "equal",
            "value": "ok"
          }
        },
        {
          "at": "/value/body_base64",
          "rule": {
            "is": "equal",
            "value": "YXV0aGVudGljYXRpb24gcHJvYmUK"
          }
        }
      ]
    },
    {
      "id": "s3-express/live-invalid-credential",
      "profile": "s3-express",
      "lane": "live",
      "purpose": "Read a pre-provisioned private object; invalid-credential control must be denied.",
      "sources": [
        "aws-sdk-cpp/generated/src/aws-cpp-sdk-s3-crt/source/S3ExpressIdentityProvider.cpp"
      ],
      "call": {
        "op": "get",
        "key": "object-tests-auth-probe",
        "credential_mode": "invalid"
      },
      "expect": [
        {
          "at": "/outcome",
          "rule": {
            "is": "equal",
            "value": "error"
          }
        },
        {
          "at": "/kind",
          "rule": {
            "is": "equal",
            "value": "permission_denied"
          }
        }
      ]
    }
  ]
}
