    {
      "id": "s3/sigv4-get-range",
      "profile": "s3",
      "lane": "vectors",
      "purpose": "Fixed-clock AWS GET range example; exact signature detects canonicalization and key-derivation defects. Whitespace in Authorization is normalized by the sign adapter only if its SDK returns structured fields.",
      "sources": [
        "https://docs.aws.amazon.com/AmazonS3/latest/API/sig-v4-header-based-auth.html"
      ],
      "call": {
        "op": "s3.sign",
        "method": "GET",
        "url": "https://examplebucket.s3.amazonaws.com/test.txt",
        "headers": {
          "range": "bytes=0-9"
        },
        "body_base64": "",
        "clock": "2013-05-24T00:00:00Z",
        "credentials": {
          "access_key_id": "AKIAIOSFODNN7EXAMPLE",
          "secret_access_key": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
        },
        "region": "us-east-1",
        "service": "s3"
      },
      "expect": [
        {
          "at": "/outcome",
          "rule": {
            "is": "equal",
            "value": "ok"
          }
        },
        {
          "at": "/value/authorization",
          "rule": {
            "is": "one_of",
            "values": [
              "AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request,SignedHeaders=host;range;x-amz-content-sha256;x-amz-date,Signature=f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41",
              "AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request, SignedHeaders=host;range;x-amz-content-sha256;x-amz-date, Signature=f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41"
            ]
          }
        }
      ]
    },
    {
      "id": "s3/canonical-get-range",
      "profile": "s3",
      "lane": "vectors",
      "purpose": "Canonical text is optional diagnostic coverage; an opaque signer can declare unsupported.",
      "sources": [
        "https://docs.aws.amazon.com/AmazonS3/latest/API/sig-v4-header-based-auth.html"
      ],
      "call": {
        "op": "s3.canonical_request",
        "method": "GET",
        "path": "/test.txt",
        "query": [],
        "headers": {
          "Host": "examplebucket.s3.amazonaws.com",
          "Range": "bytes=0-9",
          "x-amz-content-sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "x-amz-date": "20130524T000000Z"
        },
        "payload_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      },
      "expect": [
        {
          "at": "/outcome",
          "rule": {
            "is": "equal",
            "value": "ok"
          }
        },
        {
          "at": "/value/text",
          "rule": {
            "is": "equal",
            "value": "GET\n/test.txt\n\nhost:examplebucket.s3.amazonaws.com\nrange:bytes=0-9\nx-amz-content-sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nx-amz-date:20130524T000000Z\n\nhost;range;x-amz-content-sha256;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          }
        }
      ]
    },
